# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=buraya-uzun-ve-rastgele-bir-anahtar-yazin
DJANGO_ALLOWED_HOSTS=bitasarimlazim.com,www.bitasarimlazim.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bitasarimlazim.com,https://www.bitasarimlazim.com

# Nginx medya dosyalarını sunmuyorsa 1 yapın
DJANGO_SERVE_MEDIA=0
# HTTPS arkasında değilseniz (yerel test) 0 yapın
DJANGO_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1
DJANGO_HSTS_SECONDS=0

# Veritabanı (varsayılan SQLite). PostgreSQL için:
# DB_ENGINE=postgresql
# DB_NAME=bitasarim
# DB_USER=bitasarim
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# İletişim formu bildirimleri için SMTP
EMAIL_HOST=smtp.yandex.com.tr
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Bitasarımlazım <noreply@bitasarimlazim.com>
